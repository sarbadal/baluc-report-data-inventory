# -----------------------------
# Deploy script configuration
# -----------------------------
# Used by: python deployment.py --env-file deploy.env

DEPLOY_PROJECT_ID=balu-c
DEPLOY_REGION=us-central1
DEPLOY_FUNCTION_NAME=baluc-data-platform
DEPLOY_ENTRY_POINT=entry_point
DEPLOY_RUNTIME=python312

# Primary data bucket for uploaded CSV files.
DEPLOY_BUCKET_NAME=inventory-baluc

# Static asset hosting bucket (CSS/JS/images).
DEPLOY_STATIC_BUCKET_NAME=data-platform-static-baluc
DEPLOY_BUCKET_LOCATION=US

# Static upload source and destination prefix inside bucket.
DEPLOY_STATIC_DIR=app/static
DEPLOY_STATIC_GCS_PREFIX=static

# Cloud Function source root.
DEPLOY_SOURCE_DIR=.

# Optional: allow public HTTP access to function.
DEPLOY_ALLOW_UNAUTHENTICATED=true

# Optional explicit override (otherwise auto-built from static bucket + static prefix).
# DEPLOY_STATIC_ASSET_BASE_URL=https://storage.googleapis.com/data-platform-static-baluc/static


# -----------------------------
# Runtime env passed to app
# -----------------------------

FLASK_SECRET_KEY=wesac90weonwe09u23rjdwwk-sca9u23j

# App mode expected by app/config.py: dev or prod
APP_ENV=prod

# In prod deployments this will be defaulted to gcs by deployment.py if omitted.
STORAGE_BACKEND=gcs
GCS_BUCKET_NAME=inventory-baluc

# Optional folder prefix for uploaded files inside bucket
UPLOAD_BASE_PREFIX=

# Upload processor pipeline (comma-separated)
# Available: identity, rename_fields, keep_config_columns, split_daily
UPLOAD_PROCESSOR_CLASSES=rename_fields,keep_config_columns,split_daily

# Upload size limits
MAX_UPLOAD_SIZE_MB=200
# MAX_UPLOAD_SIZE_BYTES=209715200

# Optional category whitelist
# UPLOAD_ENABLED_CATEGORIES=contact,ev,print,mapping

# Optional config overrides
# UPLOAD_TYPE_RULES_FILE=app/resources/upload_types.json
# PROCESSING_CONFIG_DIR=app/resources/processing
# MAPPING_STORAGE_RULES_DIR=app/resources/processing/mapping_types

# Optional GCS credentials (if runtime does not use default service account)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
# GOOGLE_AUTH_KEY_JSON={"type":"service_account",...}

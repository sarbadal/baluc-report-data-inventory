# Flask
FLASK_SECRET_KEY=change-me

# NOTE: app/config.py auto-loads variables from .env when running python main.py.

# Storage backend: local or gcs
STORAGE_BACKEND=local
# If GOOGLE_AUTH_KEY_JSON is set, app will prefer GCS automatically.

# Required only when STORAGE_BACKEND=gcs
GCS_BUCKET_NAME=your-bucket-name

# GCS auth option 1 (recommended): point GOOGLE_APPLICATION_CREDENTIALS
# to a service-account json file path.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json

# GCS auth option 2: inline service-account json string.
# GOOGLE_AUTH_KEY_JSON={"type":"service_account",...}

# Optional folder prefix inside bucket/local storage for uploaded raw files.
# Example: incoming/raw
UPLOAD_BASE_PREFIX=

# Upload processor pipeline (comma-separated).
# Available: split_daily, rename_fields, identity
# Example: rename_fields,split_daily
UPLOAD_PROCESSOR_CLASSES=split_daily

# Local storage folder when STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=storage

# Max upload size in MB (default 200MB)
MAX_UPLOAD_SIZE_MB=200

# Optional exact override in bytes (takes precedence when set)
# MAX_UPLOAD_SIZE_BYTES=209715200

# Optional: path to JSON file containing upload type rules.
# Default: app/resources/upload_types.json
# UPLOAD_TYPE_RULES_FILE=app/resources/upload_types.json

# Optional: comma-separated category keys to enable in UI and processing.
# Example: contact,ev
# UPLOAD_ENABLED_CATEGORIES=contact,ev

# Optional: folder containing per-category processing configs (*.json).
# Default: app/resources/processing
# PROCESSING_CONFIG_DIR=app/resources/processing
# Each enabled category must have a matching file:
# <category>.json with keys: split_date_column (string), field_mapping (non-empty object)

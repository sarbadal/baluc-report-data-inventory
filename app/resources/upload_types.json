{
  "contact": {
    "match_patterns": [
      "^contact_dump_\\d{8}\\.csv$",
      "^contact_dump.*\\.csv$"
    ],
    "output_stem": "contact_dump"
  },
  "ev": {
    "match_patterns": [
      "^ev_dump_\\d{8}\\.csv$",
      "^ev_dump.*\\.csv$"
    ],
    "output_stem": "ev_dump"
  },
  "print": {
    "match_patterns": [
      "^tml_print_dump.*\\.csv$",
      "^tml_pring_dump.*\\.csv$",
      "^print_dump.*\\.csv$"
    ],
    "output_stem": "print_dump"
  }
}
